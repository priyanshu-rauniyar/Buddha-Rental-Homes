{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install Server Dependencies",
      "type": "shell",
      "command": "npm install --no-fund --no-audit --loglevel error",
      "options": {
        "cwd": "${workspaceFolder}/server",
        "env": {
          "NG_CLI_ANALYTICS": "false"
        }
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Install Client Dependencies",
      "type": "shell",
      "command": "npm install --no-fund --no-audit --loglevel error",
      "options": {
        "cwd": "${workspaceFolder}/client",
        "env": {
          "NG_CLI_ANALYTICS": "false"
        }
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Install All Dependencies",
      "dependsOn": [
        "Install Server Dependencies",
        "Install Client Dependencies"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Run Server",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/server",
        "env": {
          "NODE_ENV": "development",
          "PORT": "5000"
        }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run Client",
      "type": "shell",
      "command": "npm start",
      "options": {
        "cwd": "${workspaceFolder}/client",
        "env": {
          "NG_CLI_ANALYTICS": "false",
          "PORT": "4200"
        }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Seed Demo Data",
      "type": "shell",
      "command": "npm run seed",
      "options": {
        "cwd": "${workspaceFolder}/server",
        "env": {
          "NODE_ENV": "development"
        }
      },
      "problemMatcher": []
    }
  ]
}
